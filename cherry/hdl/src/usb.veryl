import protocol::*;

/// Reports whether a logical USB service endpoint is present in an image.
///
/// EP1 (BOOT) exists in every image. EP2 (FLASH) exists only in image 0, and
/// EP3 (UART) exists only in images 1-3. The USB descriptor generator and the
/// endpoint arbiter must both use this policy.
pub module UsbEndpointPolicy #(
    param IMAGE_ID: u32 = 0,
) (
    endpoint_number: input  logic<4>,
    enabled        : output logic,
) {
    always_comb {
        case endpoint_number {
            USB_EP_BOOT: {
                enabled = 1'b1;
            }
            USB_EP_FLASH: {
                enabled = IMAGE_ID == 0;
            }
            USB_EP_UART: {
                enabled = IMAGE_ID != 0;
            }
            default: {
                enabled = 1'b0;
            }
        }
    }
}
