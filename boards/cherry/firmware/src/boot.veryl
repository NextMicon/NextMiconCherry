/// Latches a decoded BOOT request and waits for USB/QSPI quiescence before
/// driving the iCE40 SB_WARMBOOT primitive.
///
/// Manifest/CRC validation and USB packet decoding happen before this module.
/// The framed BOOT response on the CDC IN stream must also have completed
/// before `request_valid` is asserted, so quiescing USB cannot discard the
/// host-visible response.
/// `warmboot_boot` intentionally remains asserted; successful reconfiguration
/// clears the current FPGA logic.
pub module BootController (
    clk: input clock,
    rst: input reset,

    request_valid: input  logic,
    request_user : input  logic,
    request_ready: output logic,

    quiesce : output logic,
    quiesced: input  logic,

    warmboot_s1  : output logic,
    warmboot_s0  : output logic,
    warmboot_boot: output logic,
) {
    var pending    : logic;
    var target_user: logic;
    var boot       : logic;

    assign request_ready = ~pending;
    assign quiesce       = pending;
    assign warmboot_s1   = 1'b0;
    assign warmboot_s0   = target_user;
    assign warmboot_boot = boot;

    always_ff {
        if_reset {
            pending     = 1'b0;
            target_user = 1'b0;
            boot        = 1'b0;
        } else {
            if request_valid && request_ready {
                pending     = 1'b1;
                target_user = request_user;
            }

            // `pending` was already high for at least one clock here, so the
            // target selector is stable before BOOT is asserted.
            if pending && quiesced {
                boot = 1'b1;
            }
        }
    }
}
