/// Constants shared by the CDC ACM transport and all multiboot images.
pub package protocol {
    const USB_MAX_PACKET_SIZE: u32 = 64;

    // One CDC ACM function in every image:
    //   EP1 IN     interrupt notification
    //   EP2 OUT/IN bulk serial data
    const USB_EP_CDC_NOTIFICATION_IN: logic<8> = 8'h81;
    const USB_EP_CDC_DATA_OUT       : logic<8> = 8'h02;
    const USB_EP_CDC_DATA_IN        : logic<8> = 8'h82;

    // COBS-framed application protocol carried by the CDC byte stream.
    const FRAME_VERSION         : logic<8> = 8'h01;
    const FRAME_DELIMITER       : logic<8> = 8'h00;
    const FRAME_HEADER_SIZE     : u32 = 6;
    const FRAME_CRC_SIZE        : u32 = 4;
    const FRAME_MAX_PAYLOAD_SIZE: u32 = 256;
    const FRAME_MAX_DECODED_SIZE: u32 = 266;
    const FRAME_MAX_WIRE_SIZE   : u32 = 269;
    const RESPONSE_BIT          : logic<8> = 8'h80;

    enum Channel: logic<8> {
        CHANNEL_BOOT  = 8'h01,
        CHANNEL_FLASH = 8'h02,
        CHANNEL_UART  = 8'h03,
    }

    enum BootCommand: logic<8> {
        BOOT_GET_INFO     = 8'h00,
        BOOT_SELECT_IMAGE = 8'h01,
    }

    enum FlashCommand: logic<8> {
        FLASH_ERASE_SLOT = 8'h01,
        FLASH_WRITE      = 8'h02,
        FLASH_READ       = 8'h03,
    }

    const CAPABILITY_BOOT : logic<8> = 8'h01;
    const CAPABILITY_FLASH: logic<8> = 8'h02;
    const CAPABILITY_UART : logic<8> = 8'h04;

    enum BootStatus: logic<8> {
        BOOT_ACCEPTED         = 8'h00,
        BOOT_INVALID_IMAGE    = 8'h01,
        BOOT_INVALID_MANIFEST = 8'h02,
        BOOT_BUSY             = 8'h03,
    }

    enum FlashStatus: logic<8> {
        FLASH_ACCEPTED        = 8'h00,
        FLASH_INVALID_COMMAND = 8'h01,
        FLASH_INVALID_ADDRESS = 8'h02,
        FLASH_WRITE_PROTECTED = 8'h03,
        FLASH_BUSY            = 8'h04,
        FLASH_IO_ERROR        = 8'h05,
    }

    const FLASH_ADDRESS_SIZE   : u32 = 3;
    const FLASH_WRITE_DATA_SIZE: u32 = 253;
    const FLASH_READ_DATA_SIZE : u32 = 255;

    const IMAGE_SLOT_SIZE: logic<24> = 24'h040000;
    const IMAGE0_BASE    : logic<24> = 24'h000000;
    const IMAGE1_BASE    : logic<24> = 24'h040000;
    const IMAGE2_BASE    : logic<24> = 24'h080000;
    const IMAGE3_BASE    : logic<24> = 24'h0C0000;
    const USER_DATA_BASE : logic<24> = 24'h100000;

    enum Image: logic<2> {
        IMAGE0 = 2'd0,
        IMAGE1 = 2'd1,
        IMAGE2 = 2'd2,
        IMAGE3 = 2'd3,
    }
}
