import protocol::*;

/// Reports whether a USB endpoint address belongs to the common CDC ACM
/// function. All images expose the same CDC descriptors; BOOT, FLASH, and UART
/// availability is reported inside framed GET_INFO responses instead of by
/// changing endpoint descriptors.
pub module UsbEndpointPolicy (
    endpoint_address: input  logic<8>,
    enabled         : output logic,
) {
    always_comb {
        case endpoint_address {
            USB_EP_CDC_NOTIFICATION_IN,
            USB_EP_CDC_DATA_OUT,
            USB_EP_CDC_DATA_IN: {
                enabled = 1'b1;
            }
            default: {
                enabled = 1'b0;
            }
        }
    }
}
