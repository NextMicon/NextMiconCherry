# Clock, native USB and board controls in bank 14.
set_property PACKAGE_PIN N15 [get_ports {clk_100m}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk_100m}]
set_property PACKAGE_PIN P14 [get_ports {usb_dp}]
set_property IOSTANDARD LVCMOS33 [get_ports {usb_dp}]
set_property PACKAGE_PIN P15 [get_ports {usb_dn}]
set_property IOSTANDARD LVCMOS33 [get_ports {usb_dn}]
set_property PACKAGE_PIN R14 [get_ports {default_user}]
set_property IOSTANDARD LVCMOS33 [get_ports {default_user}]
set_property PACKAGE_PIN T14 [get_ports {user_button}]
set_property IOSTANDARD LVCMOS33 [get_ports {user_button}]
set_property PACKAGE_PIN R16 [get_ports {led_user0}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_user0}]
set_property PACKAGE_PIN R17 [get_ports {led_user1}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_user1}]
create_clock -name clk_100m -period 10.000 [get_ports {clk_100m}]
set_property PULLUP true [get_ports {default_user}]
set_property PULLUP true [get_ports {user_button}]
set_property DRIVE 4 [get_ports {led_user0 led_user1}]
set_property SLEW SLOW [get_ports {led_user0 led_user1}]

# QSPI configuration pins are reserved and instantiated through STARTUPE2 after boot.